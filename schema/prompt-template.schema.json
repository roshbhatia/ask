{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "Variable": {
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
        },
        "type": {
          "type": "string",
          "enum": [
            "string",
            "bool",
            "int",
            "number",
            "json"
          ]
        },
        "description": {
          "type": "string"
        },
        "default": {
          "type": "string"
        },
        "required": {
          "type": "boolean"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "name"
      ]
    }
  },
  "properties": {
    "version": {
      "type": "string",
      "enum": [
        "ask.prompt/v2"
      ]
    },
    "name": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "description": {
      "type": "string"
    },
    "prompt": {
      "type": "string"
    },
    "schema": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "variables": {
      "items": {
        "$ref": "#/$defs/Variable"
      },
      "type": "array"
    }
  },
  "additionalProperties": false,
  "type": "object",
  "required": [
    "version",
    "name",
    "prompt"
  ],
  "title": "Ask prompt template"
}
