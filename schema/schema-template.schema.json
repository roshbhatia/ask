{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "version": {
      "type": "string",
      "enum": [
        "ask.schema/v1"
      ]
    },
    "name": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "description": {
      "type": "string"
    },
    "schema": {
      "type": "object"
    }
  },
  "additionalProperties": false,
  "type": "object",
  "required": [
    "version",
    "name",
    "schema"
  ],
  "title": "Ask schema template"
}
