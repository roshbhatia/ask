{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "EvaluationRequest": {
      "properties": {
        "state": true,
        "questions": {
          "$ref": "#/$defs/Questions"
        },
        "model": {
          "type": "string"
        },
        "directory": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "state",
        "questions",
        "directory"
      ]
    },
    "Question": {
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "boolean",
            "choice",
            "score"
          ]
        },
        "instructions": {
          "type": "string"
        },
        "choices": {
          "additionalProperties": {
            "type": "string"
          },
          "type": "object"
        },
        "levels": {
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "type",
        "instructions"
      ]
    },
    "Questions": {
      "additionalProperties": {
        "$ref": "#/$defs/Question"
      },
      "type": "object"
    }
  },
  "properties": {
    "version": {
      "type": "string",
      "enum": [
        "provider/v1"
      ]
    },
    "action": {
      "type": "string",
      "enum": [
        "inference.evaluate"
      ]
    },
    "request": {
      "$ref": "#/$defs/EvaluationRequest"
    }
  },
  "additionalProperties": false,
  "type": "object",
  "required": [
    "version",
    "action",
    "request"
  ],
  "title": "Ask provider evaluation-request"
}
