#!/usr/bin/env bash
set -euo pipefail

emit() {
  printf '%s\n' "$1"
  sleep 0.15
}

emit '{"type":"thread.started","thread_id":"demo-review"}'
emit '{"type":"item.completed","item":{"id":"reasoning","type":"reasoning","text":"I will inspect the parser boundary and run its focused tests."}}'
emit '{"type":"item.started","item":{"id":"search","type":"command_execution","command":"rg -n \"ParseToken|ValidateToken\" internal/auth"}}'
emit '{"type":"item.started","item":{"id":"test","type":"command_execution","command":"go test ./internal/auth"}}'
emit '{"type":"item.completed","item":{"id":"answer","type":"agent_message","text":"Review complete.\n\n- Rejects missing Bearer prefixes before lookup.\n- Covers empty, malformed, rejected, and accepted tokens.\n- Focused parser tests pass."}}'
emit '{"type":"turn.completed"}'
