#!/usr/bin/env bash
set -euo pipefail

emit() {
  printf '%s\n' "$1"
  sleep 0.15
}

request=$(</dev/stdin)
if [[ $request == *'"action":"provider.validate"'* ]]; then
  printf '%s\n' '{"version":"provider/v1","status":"ok"}'
  exit 0
fi

emit '{"version":"provider/v1","type":"started","text":"recorded-review"}'
emit '{"version":"provider/v1","type":"result","result":{"text":"Offline review fixture.\n\ninternal/auth/token.go rejects a misplaced Bearer prefix.\nThe empty-token and embedded-prefix cases protect session lookup."}}'
